<?xml version="1.0" encoding="utf-8"?>
<!-- Home NAS boxes are often reached over plain HTTP on the LAN (the user chooses HTTP/HTTPS per account). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
